# Dominio radice (landing pubblica). In sviluppo lascia localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Database (serve da M1 in poi). Combacia con docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comanda

# Modulo di contatto della vetrina. In sviluppo si possono lasciare vuoti: il
# modulo non compare e resta l'indirizzo da copiare. Con Gmail serve una
# "password per le app", non la password dell'account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Chiave con cui si cifrano i segreti dei locali (oggi: la password della loro
# casella di posta, usata per mandare le conferme di prenotazione). Una frase
# lunga a caso, almeno 16 caratteri. Senza, la posta del locale non si puo'
# configurare: meglio dirlo che salvare una password in chiaro.
APP_SECRET=
