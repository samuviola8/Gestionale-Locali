# Dominio radice (landing pubblica). In sviluppo lascia localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Database (serve da M1 in poi). Combacia con docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/comanda

# Modulo di contatto della vetrina. In sviluppo si possono lasciare vuoti: il
# modulo non compare e resta l'indirizzo da copiare. Con Gmail serve una
# "password per le app", non la password dell'account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=


# Segnalazioni dello staff. Arrivano su Telegram: il token lo da' @BotFather,
# il chat id si legge aprendo https://api.telegram.org/bot<TOKEN>/getUpdates
# dopo aver scritto un messaggio qualsiasi al bot. Se restano vuote, l'avviso
# ripiega sulla casella SMTP qui sopra; in ogni caso la segnalazione resta
# salvata a database e si legge da /admin/segnalazioni.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chiave con cui si cifrano i segreti dei locali (oggi: la password della loro
# casella di posta, usata per mandare le conferme di prenotazione). Una frase
# lunga a caso, almeno 16 caratteri. Senza, la posta del locale non si puo'
# configurare: meglio dirlo che salvare una password in chiaro.
APP_SECRET=

# Fatturazione: i tuoi dati da emittente, quelli che finiscono sulle fatture
# ai locali. Finche' restano vuoti la piattaforma fa i conti e prepara le
# bozze, ma non emette niente: una fattura senza partita IVA non e' una
# fattura. Il regime decide IVA e marca da bollo — "forfettario" non applica
# IVA e mette il bollo sopra i 77,47 euro, "ordinario" applica il 22%.
FATTURAZIONE_RAGIONE_SOCIALE=
FATTURAZIONE_PIVA=
FATTURAZIONE_CF=
FATTURAZIONE_INDIRIZZO=
FATTURAZIONE_CAP=
FATTURAZIONE_CITTA=
FATTURAZIONE_PROVINCIA=
FATTURAZIONE_EMAIL=
FATTURAZIONE_IBAN=
FATTURAZIONE_REGIME=forfettario
FATTURAZIONE_GIORNI_SCADENZA=15
