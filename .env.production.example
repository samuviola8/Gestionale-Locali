# Copia questo file sul server come .env.production.local e riempilo.
# Il nome finisce per .local perche' e' gia' escluso da git: le credenziali di
# produzione non devono finire nel repository.

# --- Database -----------------------------------------------------------
# Postgres sulla macchina di produzione.
DATABASE_URL=postgres://comanda:PASSWORD@localhost:5432/comanda

# --- Dominio ------------------------------------------------------------
# Il dominio radice sotto cui vivono i sottodomini dei locali.
# Con questo valore: comanda.samuviola.dev e' la vetrina,
# noya-lounge.samuviola.dev e' il locale.
NEXT_PUBLIC_ROOT_DOMAIN=samuviola.dev

# --- Ricerca indirizzi (consegna a domicilio) ---------------------------
# Senza chiave si usa Photon, gratuito ma senza garanzie di servizio.
# Per la produzione conviene una chiave vera: google | geoapify.
GEO_PROVIDER=photon
GEO_API_KEY=

# --- Porta --------------------------------------------------------------
# Su cui ascolta Next. Davanti ci sta il proxy che fa HTTPS.
PORT=3000
