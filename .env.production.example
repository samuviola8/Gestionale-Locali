# Copia questo file sul server come .env.production.local e riempilo.
# Il nome finisce per .local perche' e' gia' escluso da git: le credenziali di
# produzione non devono finire nel repository.

# --- Database -----------------------------------------------------------
# Postgres sulla macchina di produzione.
DATABASE_URL=postgres://comanda:PASSWORD@localhost:5432/comanda

# --- Dominio ------------------------------------------------------------
# Il dominio radice sotto cui vivono i sottodomini dei locali.
# Con questo valore: comanda.samuviola.dev e' la vetrina,
# noya-lounge.samuviola.dev e' il locale.
NEXT_PUBLIC_ROOT_DOMAIN=samuviola.dev

# --- Ricerca indirizzi (consegna a domicilio) ---------------------------
# Senza chiave si usa Photon, gratuito ma senza garanzie di servizio.
# Per la produzione conviene una chiave vera: google | geoapify.
GEO_PROVIDER=photon
GEO_API_KEY=

# Come si misura la distanza per il costo di consegna. Vuoto: in linea d'aria
# piu' il 30%, che e' lo scarto medio delle strade — gratis, immediato e senza
# servizi esterni nel mezzo dell'ordine. "osrm": la strada vera, una chiamata
# per ordine al router pubblico di OSM (gratuito, senza garanzie); se non
# risponde si torna alla stima.
GEO_ROUTING=

# --- Mail delle richieste dalla vetrina ---------------------------------
# Il modulo di contatto della landing spedisce da una casella vera. Con Gmail
# NON va la password dell'account: serve una "password per le app" (account
# Google -> Sicurezza -> Verifica in due passaggi -> Password per le app), che
# e' una stringa di 16 lettere e si puo' revocare senza cambiare la password.
# Senza SMTP_USER e SMTP_PASS il modulo non compare e la landing mostra
# l'indirizzo da copiare.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tuo.indirizzo@gmail.com
SMTP_PASS=
# Dove arrivano le richieste, e con che mittente partono. Vuoti: SMTP_USER.
MAIL_TO=
MAIL_FROM=

# --- Avvisi delle segnalazioni ------------------------------------------
# Lo staff dei locali segnala i problemi dal pannello in fondo alla barra
# della dashboard. L'avviso arriva su Telegram, che e' l'unico canale che
# squilla davvero: il token lo da' @BotFather, il chat id si legge aprendo
# https://api.telegram.org/bot<TOKEN>/getUpdates dopo aver scritto al bot.
# Vuote: l'avviso ripiega sulla casella SMTP qui sopra. La segnalazione e'
# comunque salvata, e si risponde da /admin/segnalazioni.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Segreti dei locali -------------------------------------------------
# Con questa chiave si cifra la password della casella di posta di ogni locale
# (quella da cui partono le conferme di prenotazione). Metti una frase lunga a
# caso, almeno 16 caratteri, e non cambiarla piu': cambiandola, le password
# gia' salvate diventano illeggibili e i locali devono reinserirle.
# Senza questa riga la posta dei locali non si puo' configurare.
APP_SECRET=

# --- Porta --------------------------------------------------------------
# Su cui ascolta Next. Davanti ci sta il proxy che fa HTTPS.
PORT=3000
